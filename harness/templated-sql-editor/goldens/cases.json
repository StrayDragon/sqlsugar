{
  "description": "Multi-field 对拍 suites — each suite targets one example with typed field overrides",
  "suites": [
    {
      "exampleId": "06-advanced-tests.sql",
      "description": "array / mapping / boolean / number / string branches",
      "cases": [
        {
          "id": "default",
          "label": "prepare defaults (arrays, mapping, numbers)",
          "overrides": null,
          "expected": "cases/06-default.expected.sql"
        },
        {
          "id": "array-in-collections",
          "label": "categories/tags arrays without electronics/premium",
          "overrides": {
            "categories": ["books", "toys"],
            "tags": ["clearance"]
          },
          "expected": "cases/06-array-in-collections.expected.sql"
        },
        {
          "id": "filters-falsy",
          "label": "filters falsy → else branch (1=1)",
          "overrides": {
            "filters": false
          },
          "expected": "cases/06-filters-falsy.expected.sql"
        },
        {
          "id": "filters-mapping-user-ids",
          "label": "filters mapping with status + user_ids join",
          "overrides": {
            "filters": {
              "status": "processing",
              "min_amount": 25,
              "max_amount": 500,
              "user_ids": [101, 202, 303]
            }
          },
          "expected": "cases/06-filters-mapping-user-ids.expected.sql"
        },
        {
          "id": "batch-divisible-by-10",
          "label": "batch_size number → Large Batch (divisibleby 10)",
          "overrides": {
            "batch_size": 100
          },
          "expected": "cases/06-batch-divisible-by-10.expected.sql"
        },
        {
          "id": "batch-divisible-by-5",
          "label": "batch_size number → Medium Batch (divisibleby 5 only)",
          "overrides": {
            "batch_size": 15
          },
          "expected": "cases/06-batch-divisible-by-5.expected.sql"
        },
        {
          "id": "is-active-boolean-false",
          "label": "is_active boolean false → sameas(false) branch",
          "overrides": {
            "is_active": false
          },
          "expected": "cases/06-is-active-boolean-false.expected.sql"
        },
        {
          "id": "selected-status-string",
          "label": "selected_status string in list + age number",
          "overrides": {
            "selected_status": "pending",
            "age": 42,
            "username": "alice",
            "email": "alice@example.com"
          },
          "expected": "cases/06-selected-status-string.expected.sql"
        }
      ]
    },
    {
      "exampleId": "05-complex-filters.sql",
      "description": "join/for arrays, defaults, featured bool, string filters",
      "cases": [
        {
          "id": "default",
          "label": "prepare defaults",
          "overrides": null,
          "expected": "cases/05-default.expected.sql"
        },
        {
          "id": "empty-collections",
          "label": "empty category_names / user_ids / roles → else branches",
          "overrides": {
            "category_names": [],
            "user_ids": [],
            "excluded_ids": [],
            "roles": [],
            "tags": []
          },
          "expected": "cases/05-empty-collections.expected.sql"
        },
        {
          "id": "pricing-pagination-numbers",
          "label": "discount/min/max/page numbers + featured true",
          "overrides": {
            "discount_rate": 0.85,
            "min_price": 12.5,
            "max_price": 199.9,
            "min_stock": 3,
            "is_featured": true,
            "page": 3,
            "page_size": 15,
            "sort_order": "DESC"
          },
          "expected": "cases/05-pricing-pagination-numbers.expected.sql"
        },
        {
          "id": "string-and-list-filters",
          "label": "string search + tags/roles/user_ids arrays + table/sort strings",
          "overrides": {
            "product_name": "  wireless_mouse  ",
            "description": "  A compact Bluetooth mouse for travel  ",
            "search_keyword": "  Mouse  ",
            "tags": ["sale", "accessory"],
            "category_names": ["peripherals", "office"],
            "user_ids": [7, 8, 9],
            "excluded_ids": [1],
            "roles": [" Admin ", "Editor"],
            "table_name": "customers",
            "custom_where_clause": "status = 'active'",
            "sort_column": "created_at",
            "sort_direction": "DESC",
            "limit": 50
          },
          "expected": "cases/05-string-and-list-filters.expected.sql"
        },
        {
          "id": "featured-false",
          "label": "is_featured false → int 0 branch",
          "overrides": {
            "is_featured": false
          },
          "expected": "cases/05-featured-false.expected.sql"
        }
      ]
    },
    {
      "exampleId": "10-comprehensive-example.sql",
      "description": "ecommerce filters: arrays, dates, amounts, bools, sort/page",
      "cases": [
        {
          "id": "default",
          "label": "prepare defaults",
          "overrides": null,
          "expected": "cases/10-default.expected.sql"
        },
        {
          "id": "status-user-date-arrays",
          "label": "order_statuses/user_ids arrays + date range strings",
          "overrides": {
            "order_statuses": ["paid", "shipped"],
            "user_ids": [11, 22],
            "start_date": "2024-01-01",
            "end_date": "2024-12-31",
            "include_time": false
          },
          "expected": "cases/10-status-user-date-arrays.expected.sql"
        },
        {
          "id": "amount-coupon-bool",
          "label": "min/max_amount numbers + has_coupon true",
          "overrides": {
            "min_amount": 50,
            "max_amount": 800,
            "has_coupon": true,
            "payment_methods": ["alipay", "wechat"],
            "shipping_method": "express"
          },
          "expected": "cases/10-amount-coupon-bool.expected.sql"
        },
        {
          "id": "sort-pagination",
          "label": "sort_by/sort_order strings + page/page_size numbers",
          "overrides": {
            "sort_by": "total_amount",
            "sort_order": "desc",
            "page": 2,
            "page_size": 25,
            "min_items": 2,
            "max_items": 20
          },
          "expected": "cases/10-sort-pagination.expected.sql"
        },
        {
          "id": "stats-and-discount-flags",
          "label": "include_statistics + calculate_discount booleans + user_level",
          "overrides": {
            "include_statistics": true,
            "calculate_discount": true,
            "user_level": "vip",
            "min_total_spent": 1000
          },
          "expected": "cases/10-stats-and-discount-flags.expected.sql"
        },
        {
          "id": "no-coupon-branch",
          "label": "has_coupon false → coupon_id IS NULL",
          "overrides": {
            "has_coupon": false
          },
          "expected": "cases/10-no-coupon-branch.expected.sql"
        }
      ]
    },
    {
      "exampleId": "03-loops-and-conditionals.sql",
      "description": "loops, for-else, object arrays, mapping filters, prices",
      "cases": [
        {
          "id": "default",
          "label": "prepare defaults",
          "overrides": null,
          "expected": "cases/03-default.expected.sql"
        },
        {
          "id": "status-date-strings",
          "label": "order_statuses array + created_after string",
          "overrides": {
            "order_statuses": ["pending", "paid", "shipped"],
            "created_after": "2024-06-01"
          },
          "expected": "cases/03-status-date-strings.expected.sql"
        },
        {
          "id": "category-objects-prices",
          "label": "categories object array (is_active filter) + min/max_price numbers",
          "overrides": {
            "categories": [
              { "id": 10, "is_active": true },
              { "id": 20, "is_active": false },
              { "id": 30, "is_active": true }
            ],
            "min_price": 9.9,
            "max_price": 120
          },
          "expected": "cases/03-category-objects-prices.expected.sql"
        },
        {
          "id": "mapping-filters",
          "label": "user_filters/order_filters mappings + limit number",
          "overrides": {
            "user_filters": {
              "status": "active",
              "region": "cn"
            },
            "order_filters": {
              "status": "completed",
              "channel": ""
            },
            "limit": 25
          },
          "expected": "cases/03-mapping-filters.expected.sql"
        },
        {
          "id": "warehouse-for-else",
          "label": "empty warehouse_ids → for-else branch + min_stock",
          "overrides": {
            "warehouse_ids": [],
            "min_stock": 5
          },
          "expected": "cases/03-warehouse-for-else.expected.sql"
        },
        {
          "id": "warehouse-ids-list",
          "label": "warehouse_ids number list IN clause",
          "overrides": {
            "warehouse_ids": [101, 202, 303],
            "min_stock": 2
          },
          "expected": "cases/03-warehouse-ids-list.expected.sql"
        }
      ]
    },
    {
      "exampleId": "15-mixed-styles.sql",
      "description": "jinja flags + named/asyncpg/pyformat/numeric param fields",
      "cases": [
        {
          "id": "default",
          "label": "prepare defaults",
          "overrides": null,
          "expected": "cases/15-default.expected.sql"
        },
        {
          "id": "named-flags-on",
          "label": "filter_by_status/role/date_range/having bools + named param values",
          "overrides": {
            "table_name": "accounts",
            "filter_by_status": true,
            "filter_by_role": true,
            "date_range": true,
            "having_count": true,
            "user_status": "active",
            "user_role": "admin",
            "start_date": "2024-01-01",
            "end_date": "2024-12-31",
            "min_order_count": 3,
            "limit": 20
          },
          "expected": "cases/15-named-flags-on.expected.sql"
        },
        {
          "id": "asyncpg-search-featured",
          "label": "category/search/date_filter/featured_only + $n params",
          "overrides": {
            "category_id": 42,
            "search_term": "%widget%",
            "date_filter": true,
            "featured_only": true,
            "1": 42,
            "2": "%widget%",
            "3": "%widget%",
            "4": "2024-01-01",
            "5": 10
          },
          "expected": "cases/15-asyncpg-search-featured.expected.sql"
        },
        {
          "id": "numeric-salary-range",
          "label": "department/salary/hire_date numbers + :n params",
          "overrides": {
            "department_id": 7,
            "min_salary": 8000,
            "max_salary": 20000,
            "hire_date_after": "2020-01-01",
            "1": 7,
            "2": 8000,
            "3": 20000,
            "4": "2020-01-01",
            "5": 0,
            "6": 50
          },
          "expected": "cases/15-numeric-salary-range.expected.sql"
        },
        {
          "id": "mixed-builder-tier",
          "label": "order_status/dates + min_orders/spent + user_tier pyformat",
          "overrides": {
            "order_status": "paid",
            "date_from": "2024-03-01",
            "date_to": "2024-09-30",
            "min_orders": 2,
            "min_spent": 500,
            "user_tier": "Gold",
            "limit": 30,
            "1": 2,
            "2": 500,
            "tier": "Gold"
          },
          "expected": "cases/15-mixed-builder-tier.expected.sql"
        },
        {
          "id": "stored-proc-branch",
          "label": "use_stored_proc true → CALL branch",
          "overrides": {
            "use_stored_proc": true,
            "order_id": 1001,
            "user_id": 55,
            "payment_method": "card",
            "1": "OUT"
          },
          "expected": "cases/15-stored-proc-branch.expected.sql"
        },
        {
          "id": "inline-insert-branch",
          "label": "use_stored_proc false → inline INSERT + product_id",
          "overrides": {
            "use_stored_proc": false,
            "order_id": 2002,
            "product_id": 88,
            "1": 3
          },
          "expected": "cases/15-inline-insert-branch.expected.sql"
        }
      ]
    }
  ]
}
